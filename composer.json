{
    "name": "omnilang/libretranslate",
    "type": "library",
    "description": "Omnilang's LibreTranslate, under any PHP host: a self-hosted server (AGPL-3.0) translating texts and HTML, detecting languages, translating files (txt, odt, odp, docx, pptx, epub, html, srt, pdf) - no key by default, one by reference for a server that asks for it, its policy declared as data.",
    "keywords": [
        "libretranslate",
        "argos-translate",
        "self-hosted",
        "open-source",
        "translation",
        "machine-translation",
        "glossary",
        "document-translation",
        "framework-agnostic",
        "omnilang"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnilang-libretranslate",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnilang": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnilang\\Libretranslate\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnilang\\Libretranslate\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
